PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-story-weaver

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# LLM Provider (openai | anthropic | stub)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o

# CORS — must match the frontend origin exactly
FRONTEND_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
